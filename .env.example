VITE_SITE_URL=https://christmasnw.com
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# NOTE: Lead form webhooks are NOT client-side env vars.
# The form posts to Cloudflare Pages Functions (/api/submit-quote, /api/backup-email),
# which read these SERVER-SIDE vars set in the Cloudflare Pages dashboard
# (Settings > Environment Variables) — no VITE_ prefix:
#   ZAPIER_WEBHOOK_URL   — Zapier catch hook for lead delivery
#   RESEND_API_KEY       — Resend key for backup email notifications
